# ============================================================================
#  Copy this file to .env  ->  cp .env.example .env  ->  paste your key.
#  The code auto-loads .env at import (src/crew.py), so you do NOT need to
#  `source .env`. Real environment variables always override these.
#  .env is git-ignored; .env.example (this placeholder) is tracked.
# ============================================================================

# ---- Traccia API key (OPTIONAL) ----
# Leave commented out to run in $0 LOCAL mode (traces write to traces.jsonl; the whole
# demo works offline with no account).
#
# Uncomment and paste your key from app.traccia.ai -> Settings -> API Keys to push the
# SAME spans to the hosted dashboard (agents, traces, per-agent cost/tokens).
#TRACCIA_API_KEY=your_traccia_api_key_here

# ---- AWS / Bedrock (Amazon Nova Pro) ----
# The crew invokes amazon.nova-pro-v1:0 in us-east-1 and makes READ-ONLY AWS calls.
# Provide AWS creds via your usual mechanism (aws configure / SSO / instance role).
# Do NOT put AWS secrets in this file. Optional overrides:
#AWS_REGION=us-east-1
